---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata | string;
  alt?: string;
  width?: number;
  class?: string;
  eager?: boolean;
}
const { src, alt = '', width = 720, class: cls, eager = false } = Astro.props;
// 图床里的图片在构建时缩小并转成 WebP（与 astro.config.mjs 里的 image.domains 保持一致）
const optimizable = typeof src === 'string' && /^https:\/\/raw\.githubusercontent\.com\//.test(src);
const loading = eager ? 'eager' : 'lazy';
---
{
  typeof src !== 'string' ? (
    <Image src={src} alt={alt} class={cls} width={Math.min(width, src.width)} loading={loading} />
  ) : optimizable ? (
    <Image src={src} alt={alt} class={cls} inferSize width={width} loading={loading} />
  ) : (
    <img src={src} alt={alt} class={cls} loading={loading} decoding="async" referrerpolicy="no-referrer" />
  )
}
