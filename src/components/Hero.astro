---
import { SITE } from '../site.config';
import Icon from './Icon.astro';
---
<section class:list={['hero glass', { 'hero-plain': !SITE.banner }]} data-reveal>
  {
    SITE.banner && (
      <div class="hero-bg" style={`--hero-lg:url(${SITE.banner});--hero-sm:url(${SITE.bannerSmall || SITE.banner})`} aria-hidden="true" />
    )
  }
  <div class="hero-shade" aria-hidden="true"></div>
  <div class="hero-content">
    <h1 class="hero-title">{SITE.title}</h1>
    <p class="hero-sub">{SITE.subtitle}</p>
    {
      SITE.slogans.length > 0 && (
        <p class="hero-typed" data-slogans={JSON.stringify(SITE.slogans)}>
          <span class="typed-text">{SITE.slogans[0]}</span>
          <span class="typed-caret" aria-hidden="true" />
        </p>
      )
    }
  </div>
  <a href="#post-list" class="hero-down" aria-label="浏览文章"><Icon name="chevron-down" size={22} /></a>
</section>
