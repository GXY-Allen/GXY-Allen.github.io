---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import PostList from '../../components/PostList.astro';
import { getTags, type TagInfo } from '../../utils/posts';

export async function getStaticPaths() {
  return (await getTags()).map((tag) => ({ params: { tag: tag.slug }, props: { tag } }));
}
interface Props {
  tag: TagInfo;
}
const { tag } = Astro.props;
---
<BaseLayout title={`标签：${tag.name}`} description={`标签「${tag.name}」下的文章`}>
  <PageHeader title={`#${tag.name}`} icon="hash" subtitle={`共 ${tag.posts.length} 篇文章`} crumbs={[{ name: '标签', href: '/tags/' }, { name: tag.name }]} />
  <PostList posts={tag.posts} />
</BaseLayout>
