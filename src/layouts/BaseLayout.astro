---
import { ClientRouter } from 'astro:transitions';
import { SITE } from '../site.config';
import Topbar from '../components/Topbar.astro';
import ProfileCard from '../components/ProfileCard.astro';
import CategoryTree from '../components/CategoryTree.astro';
import TagCloud from '../components/TagCloud.astro';
import Notice from '../components/Notice.astro';
import Calendar from '../components/Calendar.astro';
import Heatmap from '../components/Heatmap.astro';
import RecentPosts from '../components/RecentPosts.astro';
import SiteStats from '../components/SiteStats.astro';
import SearchBox from '../components/SearchBox.astro';
import Footer from '../components/Footer.astro';
import Fabs from '../components/Fabs.astro';
import Drawer from '../components/Drawer.astro';
import SettingsPanel from '../components/SettingsPanel.astro';
import SearchModal from '../components/SearchModal.astro';
import Lightbox from '../components/Lightbox.astro';
import { getActivity } from '../utils/posts';
import { BUILD_ID } from '../utils/build';

import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  /** home 首页 / post 文章 / page 其他页面 */
  variant?: 'home' | 'post' | 'page';
  /** 当前所在分类（用于左栏高亮） */
  currentCategory?: string;
  hasToc?: boolean;
  article?: { published: Date; modified: Date; tags: string[] };
  /** 只有这个页面需要的样式表（例如公式） */
  styles?: string[];
  noindex?: boolean;
}

const {
  title,
  description = SITE.description,
  image,
  variant = 'page',
  currentCategory,
  hasToc = false,
  article,
  styles = [],
  noindex = false,
} = Astro.props;

const fullTitle = title ? `${title} | ${SITE.title}` : SITE.title;
const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE.url).href;
const ogImage = new URL(image ?? SITE.banner ?? SITE.author.avatar, Astro.site ?? SITE.url).href;
const activity = await getActivity();
const activityJson = JSON.stringify(activity).replace(/</g, '\\' + 'u003c');

const settingsDefaults = {
  mode: SITE.appearance.mode,
  primary: SITE.appearance.primary,
  bg: SITE.appearance.background,
  bgCustom: '',
  bgBlur: SITE.appearance.backgroundBlur,
  cardOpacity: SITE.appearance.cardOpacity,
  fontSize: SITE.appearance.fontSize,
};
const backgrounds = SITE.backgrounds;

// 换页动画是旧正文上移淡出、新正文上滑淡入、侧栏变化的卡片淡入（animations.css、effects.ts），页面上的元素都不设 transition:name / transition:animate：
// 带 view-transition-name 的元素会截断里面卡片的毛玻璃，平时模糊不到背景，悬停文章卡片时又局部模糊，出现一块块竖条
---
<!doctype html>
<html lang={SITE.lang} data-theme="light" data-motion="on">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.author.name} />
    <meta name="generator" content={Astro.generator} />
    <meta name="build" content={BUILD_ID} />
    {!noindex && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {Astro.url.pathname === '/' && SITE.banner && <>
      <link rel="preload" as="image" href={SITE.bannerSmall || SITE.banner} media="(width < 1100px)" />
      <link rel="preload" as="image" href={SITE.banner} media="(width >= 1100px)" />
    </>}
    {styles.map((href) => <link rel="stylesheet" href={href} />)}
    <meta name="theme-color" content={SITE.appearance.primary} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={title ?? SITE.title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content={SITE.title} />
    <meta name="twitter:card" content="summary_large_image" />
    {article && <meta property="article:published_time" content={article.published.toISOString()} />}
    {article && <meta property="article:modified_time" content={article.modified.toISOString()} />}
    {article?.tags.map((t) => <meta property="article:tag" content={t} />)}

    <!-- 在页面渲染前应用外观设置，避免闪烁 -->
    <script is:inline define:vars={{ settingsDefaults, backgrounds }}>
      (function () {
        var KEY = 'blog-settings';
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        var D = Object.assign({ motion: !reduce }, settingsDefaults);
        var memory = load();
        function load() {
          try {
            var value = JSON.parse(localStorage.getItem(KEY) || '{}');
            return value && typeof value === 'object' && !Array.isArray(value) ? value : {};
          } catch (e) { return {}; }
        }
        function number(value, fallback, min, max) {
          return typeof value === 'number' && Number.isFinite(value) ? Math.min(max, Math.max(min, value)) : fallback;
        }
        function read() {
          var s = memory;
          return {
            mode: ['auto', 'light', 'dark'].includes(s.mode) ? s.mode : D.mode,
            primary: typeof s.primary === 'string' && /^#[0-9a-f]{6}$/i.test(s.primary) ? s.primary : D.primary,
            bg: typeof s.bg === 'string' && (s.bg === 'custom' || s.bg === 'upload' || backgrounds.some(function (b) { return b.id === s.bg; })) ? s.bg : D.bg,
            bgCustom: typeof s.bgCustom === 'string' && /^(https?:\/\/|\/)/i.test(s.bgCustom) && !/[\u0000-\u001f\u007f\\]/.test(s.bgCustom) ? s.bgCustom : '',
            bgBlur: number(s.bgBlur, D.bgBlur, 0, 24),
            cardOpacity: number(s.cardOpacity, D.cardOpacity, 0.35, 1),
            fontSize: number(s.fontSize, D.fontSize, 14, 22),
            motion: typeof s.motion === 'boolean' ? s.motion : D.motion,
          };
        }
        function bgOf(s) {
          if (s.bg === 'custom' && s.bgCustom) return { kind: 'image', css: 'url("' + s.bgCustom.replace(/"/g, '%22') + '")' };
          if (s.bg === 'upload') {
            try { var d = localStorage.getItem('blog-bg-upload'); if (d) return { kind: 'image', css: 'url("' + d + '")' }; } catch (e) {}
          }
          var p = backgrounds.find(function (b) { return b.id === s.bg; }) || backgrounds.find(function (b) { return b.id === D.bg; }) || backgrounds[0];
          if (!p) return { kind: 'color', css: '#eef1f6' };
          var src = p.small && window.innerWidth < 1280 ? p.small : p.value;
          return { kind: p.type, css: p.type === 'image' ? 'url("' + src + '")' : p.value };
        }
        function apply() {
          var s = read();
          var root = document.documentElement;
          var dark = s.mode === 'dark' || (s.mode === 'auto' && window.matchMedia('(prefers-color-scheme: dark)').matches);
          root.dataset.theme = dark ? 'dark' : 'light';
          root.dataset.mode = s.mode;
          root.dataset.motion = s.motion ? 'on' : 'off';
          var bg = bgOf(s);
          root.dataset.bg = bg.kind;
          var st = root.style;
          st.setProperty('--primary', s.primary);
          st.setProperty('--bg-value', bg.css);
          st.setProperty('--bg-blur', (+s.bgBlur || 0) + 'px');
          root.dataset.blur = +s.bgBlur > 0 ? 'on' : 'off';
          st.setProperty('--card-alpha', String(s.cardOpacity));
          st.setProperty('--article-size', s.fontSize / 16 + 'rem');
          var meta = document.querySelector('meta[name="theme-color"]');
          if (meta) meta.setAttribute('content', dark ? '#12141c' : s.primary);
        }
        window.__blog = {
          KEY: KEY,
          defaults: D,
          backgrounds: backgrounds,
          read: read,
          apply: apply,
          save: function (patch) {
            memory = Object.assign({}, memory, patch);
            var settings = read();
            var persisted = {};
            Object.keys(settings).forEach(function (key) {
              if (Object.prototype.hasOwnProperty.call(memory, key)) persisted[key] = settings[key];
            });
            try { localStorage.setItem(KEY, JSON.stringify(persisted)); } catch (e) {}
            apply();
            window.dispatchEvent(new CustomEvent('blog:settings', { detail: read() }));
          },
          reset: function () {
            memory = {};
            try { localStorage.removeItem(KEY); localStorage.removeItem('blog-bg-upload'); } catch (e) {}
            apply();
            window.dispatchEvent(new CustomEvent('blog:settings', { detail: read() }));
          },
        };
        apply();
        if (!window.__blogBoot) {
          window.__blogBoot = true;
          // 换页不用浏览器的 View Transition，让 Astro 直接替换页面（ClientRouter fallback="swap"），换页动画全由 effects.ts 加的 class 完成。
          // View Transition 会先把旧页面重新画一遍来截图，再暂停渲染等新页面：Edge 画这一帧时会在正文的毛玻璃上多出一条竖向色带
          // （深色下发暗、浅色下发亮），点"下一篇"时一闪而过。Astro 的脚本加载时检查这个方法，所以要在它运行前藏起来；
          // 明暗切换的圆形扩散仍用它（ui.ts 直接调用原型上的方法）
          if (document.startViewTransition) Object.defineProperty(document, 'startViewTransition', { value: undefined, configurable: true });
          // 换页时 <html> 的属性会被换成新页面里的默认值，after-swap 才由 apply() 改回来；这期间浏览器若先算了样式
          // （后退时恢复滚动位置会立刻排版），颜色、阴影会从默认外观过渡一遍。所以换页前先把当前外观写到新页面上
          document.addEventListener('astro:before-swap', function (e) {
            var from = document.documentElement;
            var to = e.newDocument.documentElement;
            ['data-theme', 'data-mode', 'data-motion', 'data-bg', 'data-blur', 'style'].forEach(function (name) {
              var v = from.getAttribute(name);
              if (v !== null) to.setAttribute(name, v);
            });
          });
          document.addEventListener('astro:after-swap', apply);
          window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', apply);
          window.matchMedia('(prefers-reduced-motion: reduce)').addEventListener('change', function (e) {
            D.motion = !e.matches;
            apply();
            window.dispatchEvent(new CustomEvent('blog:settings', { detail: read() }));
          });
          window.addEventListener('storage', function (e) {
            if (e.key === KEY || e.key === 'blog-bg-upload' || e.key === null) {
              memory = load();
              apply();
              window.dispatchEvent(new CustomEvent('blog:settings', { detail: read() }));
            }
          });
        }
      })();
    </script>
    <ClientRouter fallback="swap" />
  </head>
  <body data-variant={variant}>
    <div id="bg" class="bg-layer" transition:persist="bg" aria-hidden="true"><div class="bg-image"></div></div>
    <div id="read-progress" class="read-progress" aria-hidden="true"></div>
    <a class="skip-link" href="#main">跳到正文</a>

    <Topbar />

    <div class={`layout layout-${variant}`}>
      <aside class="side side-left" aria-label="侧边栏">
        <div class="side-inner">
          <ProfileCard />
          <CategoryTree current={currentCategory} />
          <TagCloud limit={24} />
        </div>
      </aside>

      <main id="main" class="main" tabindex="-1">
        <slot />
      </main>

      <aside class="side side-right" aria-label="工具栏">
        <div class="side-inner">
          <slot name="right-top" />
          <SearchBox />
          {variant !== 'post' && <Notice />}
          <Calendar />
          {SITE.features.heatmap && <Heatmap />}
          <RecentPosts />
          <SiteStats />
        </div>
      </aside>
    </div>

    <Footer />
    <Fabs hasToc={hasToc} />
    <slot name="overlay" />
    <Drawer />
    <SettingsPanel />
    <SearchModal />
    <Lightbox />

    <script type="application/json" id="activity-data" set:html={activityJson} />
    <script>
      import '../scripts/main';
    </script>
  </body>
</html>
