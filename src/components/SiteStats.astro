---
import { SITE } from '../site.config';
import { getStats, formatWords, formatDate } from '../utils/posts';
import Icon from './Icon.astro';

const s = await getStats();
---
<section class="widget glass stats" data-reveal>
  <div class="widget-head">
    <h2 class="widget-title"><Icon name="chart" size={17} /> 站点统计</h2>
  </div>
  <ul class="stats-list">
    <li><span><Icon name="file" size={15} /> 文章</span><b>{s.posts}</b></li>
    <li><span><Icon name="pen" size={15} /> 总字数</span><b>{formatWords(s.words)}</b></li>
    <li><span><Icon name="clock" size={15} /> 运行天数</span><b data-since={SITE.since}>-</b></li>
    <li><span><Icon name="history" size={15} /> 最后更新</span><b>{s.posts ? formatDate(s.lastUpdate) : '-'}</b></li>
  </ul>
</section>
